// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Per-shop configuration for the order-merge feature.
model Settings {
  id                  String  @id @default(cuid())
  shop                String  @unique
  autoMergeEnabled    Boolean @default(true)
  mergeWindowHours    Int     @default(24)
  shippingCostSavings Float   @default(8.5)
  locationMatchEnabled Boolean @default(true)
}

// Tracks webhook deliveries that have already been processed.
// The unique constraint on (shop, orderId) ensures a duplicate ORDERS_CREATE
// delivery for the same order is skipped rather than merged twice.
model ProcessedWebhook {
  id        String   @id @default(cuid())
  shop      String
  orderId   String
  createdAt DateTime @default(now())

  @@unique([shop, orderId])
  @@index([createdAt])
}

// One row per order absorbed by a successful merge (Consolidation History).
// Stores Shopify IDs and order names only; customer names are fetched live
// from Shopify so no personal customer data is persisted.
model MergeRecord {
  id                String   @id @default(cuid())
  shop              String
  primaryOrderId    String
  primaryOrderName  String
  mergedOrderId     String
  mergedOrderName   String
  customerId        String?
  itemsCombined     Int
  shippingSavedAmount Float @default(0)
  createdAt         DateTime @default(now())

  @@unique([shop, mergedOrderId])
  @@index([shop, createdAt])
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}
