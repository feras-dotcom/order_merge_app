// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Per-shop configuration for the order-merge feature.
model Settings {
  id                  String  @id @default(cuid())
  shop                String  @unique
  autoMergeEnabled    Boolean @default(false)
  // When the merchant last turned auto-merge on after acknowledging what it
  // does (modifies/cancels orders; never refunds duplicate shipping).
  autoMergeAcknowledgedAt DateTime?
  // Setup state. null/null = never started; started only = in setup;
  // completed = setup finished (automation was activated at that moment).
  onboardingStartedAt   DateTime?
  onboardingCompletedAt DateTime?
  mergeWindowHours    Int     @default(24)
  shippingCostSavings Float   @default(8.5)
  shopifyShopGid      String?

  // ── Shipping adjustments (v0 foundation; no execution path exists yet) ──
  // Off until the merchant explicitly opts in AND the feature is verified.
  shippingAdjustmentEnabled   Boolean   @default(false)
  // Enable-epoch: only combines completed on/after this timestamp may produce
  // an adjustment intent, so enabling never refunds historical combines.
  shippingAdjustmentEnabledAt DateTime?
  // REFUND_ALL | RETAIN_FIXED (RETAIN_FIXED is modeled, never merchant-set yet)
  shippingPolicy              String    @default("REFUND_ALL")
  // Exact minor-unit integer when RETAIN_FIXED; no Float.
  shippingRetainedMinor       String?
  shippingRetainedCurrency    String?
  // Rollout epoch: stamped on the DB wall clock when this shop is added to
  // AppControl.shippingAllowShops, cleared when removed. Combines created
  // before the CURRENT membership epoch can never produce intents, so
  // allowlisting a shop never retroactively qualifies its history.
  shippingRolloutAt           DateTime?
}

// The durable work item for an ORDERS_CREATE event: PENDING until a terminal
// outcome or a merge completion/review. status defaults to DONE so rows
// inserted by pre-migration code during a deploy overlap stay inert; legacy
// rows are backfilled with outcome LEGACY. The unique constraint on
// (shop, orderId) deduplicates repeat deliveries.
model ProcessedWebhook {
  id          String    @id @default(cuid())
  shop        String
  orderId     String
  status      String    @default("DONE")
  attempts    Int       @default(0)
  retryAfter  DateTime?
  leaseToken  String?
  leasedUntil DateTime?
  outcome     String?
  lastReason  String?
  deadlineAt  DateTime?
  doneAt      DateTime?
  // v2: why a REVIEW row needs a human, and the operation this item spawned.
  reviewReason String?
  operationId String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@unique([shop, orderId])
  @@index([createdAt])
  @@index([status, retryAfter])
}

// Lease on an order while a merge is running. A merge may only mutate orders
// it currently claims; the token fences every ownership-sensitive write so a
// stale worker can never take over, release or extend another worker's lease.
model MergeClaim {
  id          String   @id @default(cuid())
  shop        String
  orderId     String
  leaseToken  String
  leasedUntil DateTime
  createdAt   DateTime @default(now())

  @@unique([shop, orderId])
  @@index([leasedUntil])
}

// One row per order absorbed by a successful merge (Consolidation History).
// Stores Shopify IDs and order names only; customer names are fetched live
// from Shopify so no personal customer data is persisted.
model MergeRecord {
  id               String   @id @default(cuid())
  shop             String
  primaryOrderId   String
  primaryOrderName String
  mergedOrderId    String
  mergedOrderName  String
  customerId       String?
  itemsCombined    Int
  // v2: the MergeOperation this record was written from.
  operationId      String?
  createdAt        DateTime @default(now())

  @@unique([shop, mergedOrderId])
  @@index([shop, createdAt])
}

// Write-ahead journal for a merge. Created before the primary's order edit is
// committed so an interrupted merge (crash, timeout, failed cancellation) can
// be reconciled and resumed instead of leaving a secondary open whose items
// were already moved — which would double-ship them or re-merge them.
//   PENDING_COMMIT → COMMITTED → COMPLETED
//   PENDING_COMMIT → ABANDONED (commit verifiably did not apply)
//   any unfinished → NEEDS_REVIEW (state could not be confirmed; orders are
//                                  flagged and excluded from future merges)
model MergeOperation {
  id                         String   @id @default(cuid())
  shop                       String
  status                     String
  primaryOrderId             String
  primaryOrderName           String
  customerId                 String?
  primaryLineItemCountBefore Int
  addedLineItemCount         Int
  // [{ id, name, items, done }] — one entry per secondary order
  secondaries                Json
  involvedOrderIds           String[]
  attempts                   Int      @default(0)
  lastError                  String?
  leaseToken                 String?
  leasedUntil                DateTime?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  // ── Protocol v2 (phase-machine fields; v1 rows keep protocolVersion 1) ──
  protocolVersion            Int      @default(1)
  // READY | COMMIT_IN_DOUBT | COMMIT_REJECTED | APPLIED | COMPLETED |
  // ABANDONED | REVIEW_REQUIRED — null on v1 rows.
  phase                      String?
  // 8-char Crockford base32 evidence token written into the discount
  // description; unique across ops so evidence is operation-specific.
  opToken                    String?  @unique
  calculatedOrderId          String?
  // [{ secondaryId, secondaryIndex, lines: [{ sourceLineItemId, variantId,
  // quantity, description }] }] — the exact multiset the commit must produce.
  expectedTransfer           Json?
  expectedLocationId         String?
  primaryLineItemIdsBefore   String[] @default([])
  // { agreementId, happenedAt, lines: [{ secondaryId, lineItemId, variantId,
  // quantity }] } — evidence that proved the commit applied.
  appliedEvidence            Json?
  firstDispatchAt            DateTime?
  nextCheckAt                DateTime?
  reviewReason               String?
  reviewRequiredAt           DateTime?
  workItemId                 String?
  sideEffectsDone            Boolean  @default(false)

  @@index([shop, status])
  @@index([protocolVersion, phase, nextCheckAt])
  @@index([workItemId])
}

// Durable per-order lock. Never expires; created in the same transaction as
// the operation and deleted only by the terminal transition of that operation.
model MergeOrderLock {
  id          String   @id @default(cuid())
  shop        String
  orderId     String
  operationId String
  createdAt   DateTime @default(now())

  @@unique([shop, orderId])
  @@index([operationId])
}

// Write-ahead dispatch record (§0): the row exists before the Shopify request
// is sent; a response-lost mutation is reconciled as UNKNOWN, never retried
// (except the bounded ORDER_CANCEL rejection retries).
model MergeMutationAttempt {
  id              String    @id @default(cuid())
  operationId     String
  // EDIT_COMMIT | ORDER_CANCEL | REVIEW_TAG | ANNOTATE | CLOSE
  kind            String
  targetOrderId   String
  attemptNo       Int
  // DISPATCHING | SUCCEEDED | REJECTED | UNKNOWN
  state           String
  // Only the dispatcher holding this token may record the outcome.
  dispatchToken   String
  dispatchedAt    DateTime
  respondedAt     DateTime?
  responseSummary String?
  jobId           String?

  @@unique([operationId, kind, targetOrderId, attemptNo])
  @@index([operationId, kind])
}

// Kill switches (singleton row id 'control', seeded disabled by migration).
// The dispatch gate enforces these inside its UPDATE ... WHERE EXISTS.
model AppControl {
  id                String   @id
  newMergesEnabled  Boolean  @default(false)
  completionEnabled Boolean  @default(false)
  allowShops        String[] @default([]) // empty = all shops
  // ── Shipping v0 controls — separate from the merge switches above. ──
  // INVERTED allowlist semantics: empty shippingAllowShops = NO shops.
  shippingAdjustmentsEnabled Boolean  @default(false)
  shippingAllowShops         String[] @default([]) // empty = NO shops
  // Kill-switch epoch: stamped on the DB wall clock on a false→true
  // transition, cleared on disable. Combines created before the CURRENT
  // enabled epoch can never produce intents.
  shippingEnabledAt DateTime?
  note              String?
  updatedAt         DateTime @updatedAt
}

// Sweeper liveness: one row per worker instance, heartbeated every 30s.
model WorkerInstance {
  instanceId          String   @id
  railwayDeploymentId String?
  startedAt           DateTime
  heartbeatAt         DateTime
  version             String?
}

// Shipping v0 intent record (foundation only — the worker that creates and
// executes these is not implemented). One immutable intent per source order;
// the policy snapshot and the operation's creation time are frozen at intent
// creation so later Settings changes can never rewrite a queued refund target
// or smuggle a pre-epoch combine past the activation epoch.
//
// The dispatch contract (requestPayload/requestHash/marker/idempotencyKey) is
// frozen before the single allowed refund dispatch — v0 has no resend path.
// Lease columns give the future worker liveness and stale-write fencing only.
model ShippingAdjustment {
  id                    String    @id @default(cuid())
  shop                  String
  mergeOperationId      String
  sourceOrderId         String
  // MergeOperation.createdAt, snapshotted so the activation-epoch check never
  // depends on mutable join state.
  operationCreatedAt    DateTime
  // Effective activation cutoff at intent creation: the LATEST of the
  // merchant opt-in epoch, the shop rollout-membership epoch and the
  // kill-switch epoch. A future dispatch gate must recompute the cutoff and
  // require it to equal this value — any control toggle invalidates the row.
  activationCutoffAt    DateTime?
  // 'SHADOW' only — enforced by a CHECK constraint. Shadow evidence is never
  // executable: promoting an intent to a dispatchable refund requires a
  // separately authorized process and a schema change, so a future
  // dispatcher can never mistake this table's contents for live work.
  mode                  String    @default("SHADOW")
  // REFUND_ALL | RETAIN_FIXED (policy snapshot at enqueue time)
  policyKind            String
  policyRetainedMinor   String?
  policyCurrencyCode    String?
  sourceShippingMinor   String?
  plannedRefundMinor    String?
  currencyCode          String?
  // PENDING | READY | DISPATCHING | IN_DOUBT | REFUND_RECORDED | VERIFIED |
  // SKIPPED | REVIEW_REQUIRED — enforced by a CHECK constraint in SQL.
  status                String    @default("PENDING")
  idempotencyKey        String    @unique
  // ── Immutable dispatch evidence (frozen before dispatch; never rewritten
  // after dispatchedAt) ──
  // Canonical note marker that proves a Shopify refund belongs to this intent.
  marker                String?   @unique
  // The exact RefundInput sent to Shopify, serialized.
  requestPayload        Json?
  // sha256 hex of the canonical requestPayload — tamper/drift detection.
  requestHash           String?
  // The suggestedRefund preview the amounts were validated against.
  previewEvidence       Json?
  verifiedEvidence      Json?
  // ── Dispatch bookkeeping (a refund is dispatched at most once) ──
  preparedAt            DateTime?
  dispatchToken         String?
  dispatchedAt          DateTime?
  respondedAt           DateTime?
  responseSummary       String?
  // A Shopify refund id may be recorded on at most one intent.
  refundId              String?   @unique
  // ── Worker ownership (liveness + stale-write fencing only) ──
  leaseToken            String?
  leasedUntil           DateTime?
  nextCheckAt           DateTime?
  attempts              Int       @default(0)
  reasonCode            String?
  verifiedAt            DateTime?
  reviewReason          String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt

  @@unique([shop, sourceOrderId])
  @@index([status, nextCheckAt])
  @@index([mergeOperationId])
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// ═══ Shipping v0 Phase 2 (docs/SHIPPING-PHASE2-DESIGN.md Revision 3.3) ═══
// S1-A adds only these four tables plus the canonical triggers; all
// constraints beyond what Prisma can express live in the
// 20261021000000_shipping_v0_phase_2_s1a migration. Execution is strictly
// non-dispatch: the transition trigger has no PREPARED -> DISPATCHING edge.

// Singleton id='control', seeded fully off by the migration (section 4.2).
model ShippingExecuteControl {
  id                 String    @id
  admissionEnabled   Boolean   @default(false)
  // DB-clock epoch: non-null exactly while its switch is on (SQL CHECK).
  admissionEnabledAt DateTime?
  dispatchEnabled    Boolean   @default(false)
  dispatchEnabledAt  DateTime?
  globalDailyCap     Int       @default(0)
  note               String?
  updatedAt          DateTime  @default(now()) @updatedAt
}

// Primary key shop: at most one live decision per shop; an empty table means
// NO shops are approved (section 4.3). Rollforward-only in later stages.
model ShippingExecuteApproval {
  shop               String    @id
  approvedAt         DateTime
  approvedBy         String
  note               String?
  revokedAt          DateTime?
  // Merchant opt-in epoch snapshotted at approval.
  merchantOptInEpoch DateTime
  ackVersion         String
  ackRecordedAt      DateTime
  currencyCode       String
  // Whole minor units as text, '0' or a positive decimal (SQL CHECK).
  maxRefundMinor     String
  dailyCap           Int       @default(0)
  autoApprove        Boolean   @default(false)
}

// The financial record (section 5.1). CHECKs, triggers and the event journal
// live in the migration SQL; the S1 insert guard admits only
// QUEUED | SKIPPED | INELIGIBLE | REVIEW_REQUIRED rows with no evidence.
model ShippingRefund {
  id                      String   @id @default(cuid())
  shop                    String
  mergeOperationId        String
  sourceOrderId           String
  primaryOrderId          String
  primaryOrderName        String
  operationCreatedAt      DateTime
  // NULL only on a terminal CANCELLED_AT_INVALID row (SQL CHECK).
  sourceCancelledAt       DateTime?
  lane                    String   // OBSERVE | EXECUTE
  status                  String   @default("QUEUED")
  // Gate snapshot (each epoch stored individually).
  merchantEpochAt         DateTime
  rolloutEpochAt          DateTime
  switchEpochAt           DateTime
  activationCutoffAt      DateTime
  admissionEpochAt        DateTime
  admissionCutoffAt       DateTime
  // EXECUTE rows only; OBSERVE rows must keep it NULL (SQL CHECK).
  dispatchEpochAtAdmission DateTime?
  approvalApprovedAt      DateTime
  approvalOptInEpoch      DateTime
  approvalAckVersion      String
  policyKind              String   // 'REFUND_ALL'
  // Frozen financial facts and the frozen wire contract (write-once).
  currencyCode            String?
  plannedShippingMinor    String?
  parentTransactionId     String?
  gateway                 String?
  idempotencyKey          String   @unique
  marker                  String   @unique
  documentSha256          String?
  wireVariables           Json?
  wireHash                String?
  mutationVersion         String?
  preEvidence             Json?
  preparedAt              DateTime?
  // Operator wire-hash approval (PREPARED EXECUTE rows only).
  approvedWireHash        String?
  approvedAt              DateTime?
  approvedBy              String?
  // Dispatch write-ahead evidence — stamped only by PREPARED -> DISPATCHING
  // (a transition S1 has no edge for; the evidence guard governs first-set).
  dispatchToken           String?
  dispatchedAt            DateTime?
  respondedAt             DateTime?
  responseKind            String?
  responseSummary         String?
  refundId                String?  @unique
  refundCreatedAt         DateTime?
  settlementState         String?
  settlementCheckAt       DateTime?
  verifiedEvidence        Json?
  verifiedAt              DateTime?
  // Ownership: liveness and stale-write fencing only.
  leaseToken              String?
  leasedUntil             DateTime?
  nextCheckAt             DateTime?
  attempts                Int      @default(0)
  reasonCode              String?
  reviewReason            String?
  resolvedAt              DateTime?
  resolvedBy              String?
  resolution              String?
  resolutionNote          String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @default(now()) @updatedAt

  events                  ShippingRefundEvent[]

  @@unique([shop, sourceOrderId])
  @@index([status, nextCheckAt])
  @@index([shop, status])
  @@index([mergeOperationId])
  @@index([dispatchedAt])
}

// Append-only journal (section 5.2). Written only by the event-writer
// trigger; no UPDATE, DELETE or TRUNCATE. The FK column is shippingRefundId —
// 'refundId' would mean the Shopify refund GID.
model ShippingRefundEvent {
  id               String         @id
  shippingRefundId String
  at               DateTime
  fromStatus       String?
  toStatus         String
  actor            String         @default("unknown")

  shippingRefund   ShippingRefund @relation(fields: [shippingRefundId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([shippingRefundId])
  @@index([at])
}
