server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;
    absolute_redirect off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;

    error_page 404 /404.html;

    location = /privacy {
        try_files /privacy/index.html =404;
    }

    location = /demo {
        try_files /demo/index.html =404;
    }

    location = /guides {
        try_files /guides/index.html =404;
    }

    location = /guides/how-to-combine-shopify-orders {
        try_files /guides/how-to-combine-shopify-orders/index.html =404;
    }

    location = /site.css {
        expires -1;
        try_files /site.css =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    location ~* \.(?:css|js|ico|png|jpg|jpeg|webp|svg)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800, immutable";
        try_files $uri =404;
    }
}
